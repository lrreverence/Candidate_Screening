# =============================================================================
# Copy to ".env" or ".env.local" and fill in values (never commit real secrets).
# =============================================================================

# --- Vite / browser (prefix VITE_ is required for import.meta.env in the app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: full origin when the notify API is not same-origin (e.g. local Vite
# hitting a deployed preview). Leave empty in production on Vercel if the app
# and /api share the same domain.
# VITE_NOTIFY_API_BASE=https://your-deployment.vercel.app

# --- Vercel serverless: api/notify-application-status.js
# Set these in Vercel Project → Environment Variables for production.
# For local email testing with "vercel dev", you can put them in .env.local too
# (no VITE_ prefix — they are not exposed to the browser bundle).

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=E Power Security <noreply@caesarisidrovaay.online>

# Used only on the server to load application + applicant after admin JWT check.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: if you prefer not to duplicate VITE_* names on Vercel, set these
# instead of (or as well as) VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# The handler accepts either pair.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key
